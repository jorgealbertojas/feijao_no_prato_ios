platform :ios, '16.0'
use_frameworks!

target 'FeijaoNoPrato' do
  # Networking
  pod 'Alamofire', '~> 5.9'

  # Image loading (replaces Coil — AsyncImage covers static images natively;
  # SDWebImageSwiftUI is needed only for GIF support like the splash animation)
  pod 'SDWebImageSwiftUI', '~> 3.0'

  # JSON (Codable is built-in; no extra pod needed unless you use Moya)
end
